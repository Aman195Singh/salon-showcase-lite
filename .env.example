# ==============================================================
# SALON SHOWCASE LITE — ENVIRONMENT VARIABLES
# ==============================================================
# NOTE: This app works 100% out-of-the-box in Demo Mode without
# any environment variables!
#
# If you want to connect a live Supabase database for persistent
# live data, create a free project at https://supabase.com, run
# the `supabase-setup.sql` script, and paste your keys below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin passcode for /admin (Default fallback is 'admin123')
ADMIN_PASSCODE=admin123
